<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aboutpage">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 🌿 TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mind Calculator 🧠"
            android:textSize="32sp"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Understand your mental load"
            android:textColor="#E6101010"
            android:layout_marginBottom="20dp"/>

        <!-- INPUT CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="178dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/dashboard_card_bg"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 🔹 NUMBER 1 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Number 1"
                android:textColor="#000"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="Enter first value"
                android:inputType="numberDecimal" />

            <!-- SPACE -->
            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <TextView
                android:id="@+id/operatorView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:text="+"
                android:textColor="#000"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- 🔹 NUMBER 2 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Number 2"
                android:textColor="#000"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="Enter second value"
                android:inputType="numberDecimal" />

        </LinearLayout>

        <!-- OPERATORS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="4"
            android:layout_marginBottom="15dp">

            <Button
                android:layout_height="wrap_content"
                android:id="@+id/addBtn"
                android:text="+"
                android:textSize="50sp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:background="@drawable/button_bg"
                android:textColor="@android:color/white"/>

            <Button
                android:layout_height="wrap_content"
                android:id="@+id/subBtn"
                android:text="-"
                android:textSize="50sp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/button_bg"
                android:textColor="@android:color/white"/>

            <Button
                android:layout_height="wrap_content"
                android:id="@+id/mulBtn"
                android:text="×"
                android:textSize="50sp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/button_bg"
                android:textColor="@android:color/white"/>

            <Button
                android:layout_height="wrap_content"
                android:id="@+id/divBtn"
                android:text="÷"
                android:textSize="50sp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/button_bg"
                android:textColor="@android:color/white"/>
        </LinearLayout>

        <!-- CALCULATE -->
        <Button
            android:id="@+id/calcBtn"
            android:layout_width="match_parent"
            android:layout_height="94dp"
            android:layout_weight="10"
            android:background="@drawable/button_bg"
            android:text="Calculate Mental Load"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="50sp" />

        <!-- RESULT CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/dashboard_card_bg"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Result"
                android:textColor="#000"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/result"
                android:layout_width="wrap_content"
                android:layout_height="77dp"
                android:layout_marginTop="6dp"
                android:text="Your mental state will appear here"
                android:textColor="#333"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- 📘 HOW IT WORKS -->
        <LinearLayout
            android:layout_marginTop="10sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/dashboard_card_bg"
            android:padding="16dp"
            android:elevation="8dp"
            android:layout_marginBottom="15dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How it works 💡"
                android:textStyle="bold"
                android:textColor="#000"/>

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Enter two values representing stress factors. Choose an operation to simulate how they interact.\n\n➕ Combine stress\n➖ Reduce burden\n✖ Amplify impact\n➗ Balance emotions"
                android:textColor="#444444"
                android:layout_marginTop="6dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
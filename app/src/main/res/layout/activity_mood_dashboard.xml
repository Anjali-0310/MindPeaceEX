<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 🌿 BACKGROUND -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/mooddash"
        android:scaleType="centerCrop"/>

    <!-- 🌿 LIGHT OVERLAY -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"/>

    <!-- 🌿 CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mood Dashboard ✨"
                android:textSize="34sp"
                android:letterSpacing="0.08"
                android:textColor="@android:color/white"
                android:fontFamily="@font/playfair_bold"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Choose a feature to improve your well-being"
                android:textColor="#E6FFFFFF"
                android:textSize="14sp"
                android:layout_marginBottom="20dp"/>

            <!-- 🔥 CARD TEMPLATE -->
            <!-- Guided -->
            <LinearLayout
                android:id="@+id/guided"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/dashboard_card_bg"
                android:gravity="center_vertical"
                android:elevation="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧘 Guided Meditations"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppins_medium"/>
            </LinearLayout>

            <!-- Journal -->
            <LinearLayout
                android:id="@+id/journal"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:background="@drawable/dashboard_card_bg"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:elevation="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📓 Mood Journal"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppins_medium"/>
            </LinearLayout>

            <!-- Gratitude -->
            <LinearLayout
                android:id="@+id/gratitude"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:background="@drawable/dashboard_card_bg"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:elevation="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💛 Gratitude Journal"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppins_medium"/>
            </LinearLayout>

            <!-- Breathing -->
            <LinearLayout
                android:id="@+id/breathing"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:background="@drawable/dashboard_card_bg"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:elevation="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌬 Breathing Exercise"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppins_medium"/>
            </LinearLayout>

            <!-- Visualizer -->
            <LinearLayout
                android:id="@+id/visualizer"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:background="@drawable/dashboard_card_bg"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:elevation="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 Mood Visualizer"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppins_medium"/>
            </LinearLayout>

            <!-- Sound -->
            <LinearLayout
                android:id="@+id/sound"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:background="@drawable/dashboard_card_bg"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:elevation="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎧 Soundscapes"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppins_medium"/>
            </LinearLayout>

            <!-- Reminder -->
            <LinearLayout
                android:id="@+id/reminder"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:background="@drawable/dashboard_card_bg"
                android:padding="20dp"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical"
                android:elevation="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏰ Mindful Reminders"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppins_medium"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/calculatorCard"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/dashboard_card_bg"
                android:layout_marginBottom="12dp"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_height="wrap_content"
                    android:text="🧮 Mind Calculator"
                    android:textSize="18sp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:textColor="#000"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/cameraCard"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/dashboard_card_bg"
                android:layout_marginBottom="12dp"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_height="wrap_content"
                    android:text="📷 Capture Calm Moment"
                    android:textSize="18sp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:textColor="#000"/>

            </LinearLayout>
        </LinearLayout>

    </ScrollView>

</RelativeLayout>